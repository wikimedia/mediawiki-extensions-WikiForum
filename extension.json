{
	"name": "WikiForum",
	"version": "2.9.0",
	"author": [
		"Michael Chlebek",
		"Jack Phoenix",
		"Adam Carter (UltrasonicNXT)"
	],
	"url": "https://www.mediawiki.org/wiki/Extension:WikiForum",
	"descriptionmsg": "wikiforum-desc",
	"license-name": "GPL-3.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"callback": "WikiForumHooks::registerExtension",
	"GroupPermissions": {
		"forumadmin": {
			"wikiforum-admin": true,
			"wikiforum-moderator": true
		},
		"sysop": {
			"wikiforum-admin": true,
			"wikiforum-moderator": true
		}
	},
	"AddGroups": {
		"bureaucrat": [
			"forumadmin"
		]
	},
	"RemoveGroups": {
		"bureaucrat": [
			"forumadmin"
		]
	},
	"AvailableRights": [
		"wikiforum-admin",
		"wikiforum-moderator"
	],
	"DefaultUserOptions": {
		"echo-subscriptions-web-wikiforum-comment": true,
		"echo-subscriptions-email-wikiforum-comment": true
	},
	"SpecialPages": {
		"WikiForum": {
			"class": "SpecialWikiForum",
			"services": [
				"ReadOnlyMode"
			]
		}
	},
	"LogTypes": [
		"forum"
	],
	"LogActionsHandlers": {
		"forum/*": "WikitextLogFormatter"
	},
	"MessagesDirs": {
		"WikiForum": [
			"i18n",
			"i18n/api"
		]
	},
	"ExtensionMessagesFiles": {
		"WikiForumAlias": "includes/WikiForum.i18n.alias.php"
	},
	"APIModules": {
		"wikiforum-admin-delete": "ApiWikiForumAdminDelete",
		"wikiforum-set-thread-stickiness": "ApiWikiForumSetThreadStickiness",
		"wikiforum-sort": "ApiWikiForumSort",
		"wikiforum-delete-thread": {
			"class": "ApiWikiForumDeleteThread",
			"services": [
				"ConnectionProvider"
			]
		}
	},
	"AutoloadClasses": {
		"ApiWikiForumAdminDelete": "includes/api/ApiWikiForumAdminDelete.php",
		"ApiWikiForumSetThreadStickiness": "includes/api/ApiWikiForumSetThreadStickiness.php",
		"ApiWikiForumSort": "includes/api/ApiWikiForumSort.php",
		"ApiWikiForumDeleteThread": "includes/api/ApiWikiForumDeleteThread.php",
		"MigrateOldWikiForumTimestampColumnsToNew": "maintenance/migrateOldWikiForumTimestampColumnsToNew.php",
		"MigrateOldWikiForumUserColumnsToActor": "maintenance/migrateOldWikiForumUserColumnsToActor.php",
		"EchoMentionWikiForumCommentPresentationModel": "includes/notifications/EchoMentionWikiForumCommentPresentationModel.php",
		"WikiForumHooks": "includes/WikiForumHooks.php",
		"WikiForumGui": "includes/WikiForumGui.php",
		"WikiForum": "includes/WikiForum.php",
		"SpecialWikiForum": "includes/specials/SpecialWikiForum.php",
		"WFReply": "includes/WFReply.php",
		"WFThread": "includes/WFThread.php",
		"WFForum": "includes/WFForum.php",
		"WFCategory": "includes/WFCategory.php",
		"LockInactiveThreadJob": "includes/jobs/LockInactiveThreadJob.php"
	},
	"ResourceModules": {
		"ext.wikiForum": {
			"styles": "css/styles.css"
		},
		"ext.wikiForum.admin-links": {
			"scripts": "js/ext.wikiForum.admin-links.js",
			"dependencies": "mediawiki.api",
			"messages": [
				"wikiforum-confirm-delete-category",
				"wikiforum-confirm-delete-forum"
			]
		},
		"ext.wikiForum.admin-sticky-links": {
			"scripts": "js/ext.wikiForum.admin-sticky-links.js",
			"dependencies": "mediawiki.api"
		},
		"ext.wikiForum.close-reopen-links": {
			"scripts": "js/ext.wikiForum.close-reopen-links.js",
			"dependencies": "mediawiki.user"
		},
		"ext.wikiForum.delete-links": {
			"scripts": "js/ext.wikiForum.delete-links.js",
			"dependencies": "mediawiki.api",
			"messages": [
				"wikiforum-confirm-delete-thread",
				"wikiforum-confirm-delete-reply",
				"wikiforum-error-delete"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "resources",
		"remoteExtPath": "WikiForum/resources"
	},
	"Hooks": {
		"BeforeCreateEchoEvent": "WikiForumHooks::onBeforeCreateEchoEvent",
		"ParserFirstCallInit": "WikiForumHooks::registerParserHooks",
		"LoadExtensionSchemaUpdates": "WikiForumHooks::onLoadExtensionSchemaUpdates"
	},
	"CaptchaTriggers": {
		"wikiforum": true
	},
	"JobClasses": {
		"lockInactiveThread": "LockInactiveThreadJob"
	},
	"config": {
		"WikiForumAbuseFilterGroup": {
			"description": "Custom group name for AbuseFilter, for when that extension is installed. It ensures that AbuseFilter only pulls the filters related to WikiForum. If you would like AbuseFilter to pull all of the filters, enter 'default' here.",
			"value": "wikiforum"
		},
		"WikiForumAllowAnonymous": {
			"description": "Allow anonymous users to post on the forum?",
			"value": true
		},
		"WikiForumLogInRC": {
			"description": "Show forum-related log actions in recent changes?",
			"value": true
		},
		"WikiForumAutoLockInactiveHours": {
			"description": "If set to a numeric value, threads are automatically closed by a background job after this many hours. When set to null (which is the default), threads are not automatically closed by the software.",
			"value": null
		}
	},
	"manifest_version": 2
}
